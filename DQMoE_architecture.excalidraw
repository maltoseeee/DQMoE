    {
      "type": "text",
      "id": "diff_box2_t",
      "x": 420, "y": 839,
      "width": 310, "height": 106,
      "text": "Three Quantization Modes\nQDQ: 1 global scale (fast, less accurate)\nRowWise: per-token scale (balanced)\nBlockWise 1×128: per-128-block scale\n(best accuracy, SM90/100 only)",
      "originalText": "Three Quantization Modes\nQDQ: 1 global scale (fast, less accurate)\nRowWise: per-token scale (balanced)\nBlockWise 1×128: per-128-block scale\n(best accuracy, SM90/100 only)",
      "fontSize": 13, "fontFamily": 3,
      "textAlign": "left", "verticalAlign": "middle",
