    {
      "type": "text",
      "id": "diff_box1_t",
      "x": 70, "y": 839,
      "width": 310, "height": 106,
      "text": "Dynamic Quantization\nActivation is quantized ONLINE after\nSiLU, not pre-quantized offline.\nScale computed per-token or per-block\nat inference time → better accuracy.",
      "originalText": "Dynamic Quantization\nActivation is quantized ONLINE after\nSiLU, not pre-quantized offline.\nScale computed per-token or per-block\nat inference time → better accuracy.",
